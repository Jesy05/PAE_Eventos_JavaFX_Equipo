<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.pae_eventos_javafx_equipo.ArtesaniasController">
    <top>
        <VBox>
            <MenuBar>
                <menus>
                    <Menu text="Catalogo">
                        <items>
                            <MenuItem text="Nuevo producto" onAction="#nuevoProducto"/>
                            <MenuItem text="Guardar catalogo" onAction="#guardarCatalogo"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Volver al menu principal" onAction="#volver"/>
                        </items>
                    </Menu>
                    <Menu text="Ventas">
                        <items>
                            <MenuItem text="Registrar venta" onAction="#registrarVenta"/>
                        </items>
                    </Menu>
                    <Menu text="Ayuda">
                        <items>
                            <MenuItem text="Acerca de" onAction="#acercaDe"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <ToolBar>
                <items>
                    <Button text="Volver" onAction="#volver"/>
                    <Separator/>
                    <Button text="Nuevo" onAction="#nuevoProducto"/>
                    <Button text="Guardar" onAction="#guardarCatalogo"/>
                    <Separator/>
                    <Label text="Buscar:"/>
                    <TextField fx:id="txtBuscar" promptText="nombre y ENTER"
                               onKeyPressed="#buscarProducto"/>
                    <Button text="Buscar" onAction="#buscarPorBoton"/>
                </items>
            </ToolBar>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tablaArtesanias">
            <BorderPane.margin>
                <Insets top="10.0" right="12.0" bottom="6.0" left="12.0"/>
            </BorderPane.margin>
            <columns>
                <TableColumn fx:id="colImagen"    text="Imagen"      prefWidth="70.0"/>
                <TableColumn fx:id="colCodigo"    text="Codigo"      prefWidth="80.0"/>
                <TableColumn fx:id="colNombre"    text="Nombre"      prefWidth="240.0"/>
                <TableColumn fx:id="colCategoria" text="Categoria"   prefWidth="130.0"/>
                <TableColumn fx:id="colPrecio"    text="Precio (C$)" prefWidth="110.0"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label fx:id="lblEstado" text="Catalogo cargado.">
            <padding><Insets top="8.0" right="12.0" bottom="12.0" left="12.0"/></padding>
        </Label>
    </bottom>
</BorderPane>