<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.pae_eventos_javafx_equipo.MainController"
      alignment="CENTER" spacing="16.0">
    <padding>
        <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
    </padding>

    <Label text="Eventos y navegacion en JavaFX"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Casos empresariales nicaraguenses - Trabajo en pareja"/>

    <Button text="Reto 1 - Inventario de pulperia" prefWidth="320.0" onAction="#abrirInventario"/>
    <Button text="Reto 2 - Recepcion de cafe" prefWidth="320.0" onAction="#abrirCafe"/>
    <Button text="Reto 3 - Tienda de artesanias" prefWidth="320.0" onAction="#abrirArtesanias"/>
    <Button text="Salir" prefWidth="320.0" onAction="#salir"/>
</VBox>